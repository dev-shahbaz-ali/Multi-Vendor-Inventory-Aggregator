<%- include('partials/header') %>

<div class="card shadow-sm mx-auto" style="max-width: 500px">
  <div class="card-header bg-success text-white">
    <h2 class="h5 mb-0">🔧 Update Product Stock</h2>
  </div>
  <div class="card-body">
    <form id="stockForm">
      <div class="mb-3">
        <label class="form-label fw-bold">Select Product</label>
        <select id="productId" class="form-select" required>
          <option value="">Loading products...</option>
        </select>
      </div>
      <div class="row mb-3">
        <div class="col">
          <label class="form-label fw-bold">Current Stock</label>
          <input
            type="number"
            id="stock"
            class="form-control"
            min="0"
            required
          />
        </div>
        <div class="col">
          <label class="form-label fw-bold">Low Stock Alert at</label>
          <input
            type="number"
            id="threshold"
            class="form-control"
            min="0"
            required
          />
        </div>
      </div>
      <button type="submit" class="btn btn-success w-100 py-2 fw-bold">
        Update Inventory
      </button>
    </form>
    <div id="message" class="mt-3 alert d-none"></div>
    <div class="mt-3 text-center">
      <a href="/inventory-list" class="text-decoration-none"
        >← Back to Stock Levels</a
      >
    </div>
  </div>
</div>

<script>
  async function loadProducts() {
    try {
      const res = await fetch("/api/products");
      const products = await res.json();
      const select = document.getElementById("productId");
      select.innerHTML =
        '<option value="">-- Choose a Product --</option>' +
        products
          .map((p) => `<option value="${p._id}">${p.name} (${p.sku})</option>`)
          .join("");
    } catch (err) {
      console.error("Error loading products:", err);
    }
  }

  document.getElementById("productId").onchange = async (e) => {
    const id = e.target.value;
    if (!id) return;
    try {
      const res = await fetch(`/api/inventory/product/${id}`);
      const result = await res.json();
      if (result.success && result.data) {
        document.getElementById("stock").value = result.data.stock;
        document.getElementById("threshold").value =
          result.data.lowStockThreshold;
      }
    } catch (err) {
      console.error("Error fetching current stock");
    }
  };

  document.getElementById("stockForm").onsubmit = async (e) => {
    e.preventDefault();
    const msg = document.getElementById("message");
    msg.classList.add("d-none");

    const payload = {
      productId: document.getElementById("productId").value,
      stock: parseInt(document.getElementById("stock").value),
      lowStockThreshold: parseInt(document.getElementById("threshold").value),
    };

    try {
      const res = await fetch("/api/inventory", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (res.ok) {
        msg.className = "mt-3 alert alert-success";
        msg.textContent = "Inventory updated successfully!";
      } else {
        throw new Error(data.error || "Update failed");
      }
    } catch (err) {
      msg.className = "mt-3 alert alert-danger";
      msg.textContent = err.message;
    }
    msg.classList.remove("d-none");
  };
  loadProducts();
</script>

<%- include('partials/footer') %>
