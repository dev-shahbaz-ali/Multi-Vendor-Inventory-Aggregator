<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | Inventory Aggregator</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <script src="/socket.io/socket.io.js"></script>
    <style>
      :root {
        --primary-color: #4e73df;
        --secondary-color: #858796;
        --success-color: #1cc88a;
      }
      body {
        background-color: #f8f9fc;
        font-family:
          "Inter",
          system-ui,
          -apple-system,
          sans-serif;
      }
      .navbar {
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
      }
      .navbar-brand {
        font-weight: 800;
        letter-spacing: 0.05rem;
      }
      .card {
        border: none;
        border-radius: 0.35rem;
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.1);
      }
      .card-header {
        background-color: #f8f9fc;
        border-bottom: 1px solid #e3e6f0;
        font-weight: bold;
        color: var(--primary-color);
      }
      .table thead th {
        background-color: #f8f9fc;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.05rem;
        border-bottom: 2px solid #e3e6f0;
      }
      .badge-soft-danger {
        background-color: #f8d7da;
        color: #721c24;
      }
      #alert-badge {
        display: none;
      }
      .nav-link.active {
        color: #fff !important;
        font-weight: bold;
        border-bottom: 2px solid var(--primary-color);
      }
    </style>
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top mb-4">
      <div class="container">
        <a class="navbar-brand" href="/dashboard">📦 INV-AGGREGATOR</a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <a
                class="nav-link <%= title === 'Dashboard' ? 'active' : '' %>"
                href="/dashboard"
                >Dashboard</a
              >
            </li>
            <li class="nav-item dropdown">
              <a
                class="nav-link dropdown-toggle <%= title.includes('Product') ? 'active' : '' %>"
                href="#"
                role="button"
                data-bs-toggle="dropdown"
                >Products</a
              >
              <ul class="dropdown-menu">
                <li>
                  <a class="dropdown-item" href="/products-list"
                    >View Catalog</a
                  >
                </li>
                <li>
                  <a class="dropdown-item" href="/add-product">Add Product</a>
                </li>
              </ul>
            </li>
            <li class="nav-item dropdown">
              <a
                class="nav-link dropdown-toggle <%= title.includes('Inventory') || title.includes('Stock') ? 'active' : '' %>"
                href="#"
                role="button"
                data-bs-toggle="dropdown"
                >Inventory</a
              >
              <ul class="dropdown-menu">
                <li>
                  <a class="dropdown-item" href="/inventory-list"
                    >Stock Levels</a
                  >
                </li>
                <li>
                  <a class="dropdown-item" href="/manage-inventory"
                    >Update Stock</a
                  >
                </li>
              </ul>
            </li>
            <li class="nav-item">
              <a
                class="nav-link <%= title === 'Process Purchase' ? 'active' : '' %>"
                href="/make-purchase"
                >Buy Products</a
              >
            </li>
            <li class="nav-item">
              <a
                class="nav-link <%= title === 'Transaction History' ? 'active' : '' %>"
                href="/purchase-history"
                >History</a
              >
            </li>
          </ul>
          <div class="d-flex">
            <span class="badge bg-danger rounded-pill mt-2" id="alert-badge"
              >Low Stock Alerts</span
            >
          </div>
        </div>
      </div>
    </nav>
    <div class="container pb-5">
