<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">System Overview</h1>
  <span id="ws-status" class="badge bg-secondary">Connecting...</span>
</div>

<!-- Stat cards -->
<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="card border-start border-success border-4 shadow-sm h-100">
      <div class="card-body">
        <div class="text-muted small text-uppercase fw-bold mb-1">Status</div>
        <div class="h5 mb-0 fw-bold text-success">System Online</div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-start border-primary border-4 shadow-sm h-100">
      <div class="card-body">
        <div class="text-muted small text-uppercase fw-bold mb-1">Total Alerts</div>
        <div class="h5 mb-0 fw-bold" id="stat-total">0</div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-start border-danger border-4 shadow-sm h-100">
      <div class="card-body">
        <div class="text-muted small text-uppercase fw-bold mb-1">Critical</div>
        <div class="h5 mb-0 fw-bold text-danger" id="stat-critical">0</div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-start border-warning border-4 shadow-sm h-100">
      <div class="card-body">
        <div class="text-muted small text-uppercase fw-bold mb-1">Low Stock</div>
        <div class="h5 mb-0 fw-bold text-warning" id="stat-warning">0</div>
      </div>
    </div>
  </div>
</div>

<!-- Live alert feed -->
<div class="card shadow-sm">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span class="fw-bold">Live Inventory Alerts</span>
    <button class="btn btn-sm btn-outline-secondary" onclick="clearAlerts()">Clear</button>
  </div>
  <div class="card-body p-0">
    <div id="alert-feed" style="max-height: 420px; overflow-y: auto;">
      <div id="no-alerts" class="text-center text-muted py-5">
        No alerts yet — alerts appear here in real-time.
      </div>
    </div>
  </div>
</div>

<script>
  window._socketInit = true; // prevent footer from opening a second connection

  let totalAlerts = 0;
  let criticalCount = 0;
  let warningCount = 0;

  const socket = io();

  socket.on("connect", () => {
    document.getElementById("ws-status").textContent = "Connected";
    document.getElementById("ws-status").className = "badge bg-success";
    socket.emit("subscribe_alerts");
  });

  socket.on("disconnect", () => {
    document.getElementById("ws-status").textContent = "Disconnected";
    document.getElementById("ws-status").className = "badge bg-danger";
  });

  socket.on("low_stock_alert", (data) => {
    const isCritical = data.severity === "CRITICAL";

    totalAlerts++;
    if (isCritical) criticalCount++;
    else warningCount++;

    document.getElementById("stat-total").textContent = totalAlerts;
    document.getElementById("stat-critical").textContent = criticalCount;
    document.getElementById("stat-warning").textContent = warningCount;

    // Update nav badge
    const badge = document.getElementById("alert-badge");
    if (badge) {
      badge.style.display = "inline-block";
      badge.textContent = totalAlerts;
    }

    // Remove placeholder
    const noAlerts = document.getElementById("no-alerts");
    if (noAlerts) noAlerts.remove();

    // Build alert row
    const time = new Date().toLocaleTimeString();
    const bgClass = isCritical ? "border-danger bg-danger bg-opacity-10" : "border-warning bg-warning bg-opacity-10";
    const badgeClass = isCritical ? "bg-danger" : "bg-warning text-dark";
    const icon = isCritical ? "🚨" : "⚠️";

    const row = document.createElement("div");
    row.className = `d-flex align-items-start gap-3 p-3 border-bottom border-start border-3 ${bgClass}`;
    row.innerHTML = `
      <div class="fs-4 mt-1">${icon}</div>
      <div class="flex-grow-1">
        <div class="d-flex justify-content-between align-items-center">
          <span class="fw-bold">${data.productName || "Unknown Product"}</span>
          <span class="badge ${badgeClass} ms-2">${data.severity}</span>
        </div>
        <div class="small text-muted mt-1">
          SKU: <code>${data.sku || "N/A"}</code> &nbsp;|&nbsp;
          Stock: <strong>${data.currentStock}</strong> &nbsp;|&nbsp;
          Threshold: ${data.threshold}
        </div>
        <div class="small text-muted">${data.message || ""}</div>
      </div>
      <div class="text-muted small text-nowrap">${time}</div>
    `;

    const feed = document.getElementById("alert-feed");
    feed.insertBefore(row, feed.firstChild);
  });

  function clearAlerts() {
    const feed = document.getElementById("alert-feed");
    feed.innerHTML = '<div id="no-alerts" class="text-center text-muted py-5">No alerts yet — alerts appear here in real-time.</div>';
    totalAlerts = 0; criticalCount = 0; warningCount = 0;
    document.getElementById("stat-total").textContent = 0;
    document.getElementById("stat-critical").textContent = 0;
    document.getElementById("stat-warning").textContent = 0;
    const badge = document.getElementById("alert-badge");
    if (badge) { badge.style.display = "none"; badge.textContent = ""; }
  }
</script>

<%- include('partials/footer') %>
