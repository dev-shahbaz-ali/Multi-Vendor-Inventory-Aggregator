<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">📦 Product Catalog</h1>
  <a href="/add-product" class="btn btn-primary">+ Add New Product</a>
</div>

<div class="table-responsive bg-white rounded shadow-sm">
  <table class="table table-hover align-middle mb-0">
    <thead class="table-light">
      <tr>
        <th>Product Name</th>
        <th>SKU</th>
        <th>Current Price</th>
        <th>Description</th>
        <th>Date Added</th>
      </tr>
    </thead>
    <tbody id="productsList">
      <tr>
        <td colspan="5" class="text-center py-4">Loading products...</td>
      </tr>
    </tbody>
  </table>
</div>

<script>
  async function fetchProducts() {
    const listEl = document.getElementById("productsList");
    try {
      const response = await fetch("/api/products");
      const products = await response.json();

      if (!products.length) {
        listEl.innerHTML =
          '<tr><td colspan="5" class="text-center py-4 text-muted">No products found.</td></tr>';
        return;
      }

      listEl.innerHTML = products
        .map(
          (p) => `
                <tr>
                    <td class="fw-bold text-dark">${p.name || "N/A"}</td>
                    <td><span class="badge bg-secondary font-monospace">${p.sku || "N/A"}</span></td>
                    <td class="text-success fw-bold">$${(p.currentPrice || 0).toFixed(2)}</td>
                    <td class="text-muted small">${p.description || "-"}</td>
                    <td>${p.createdAt ? new Date(p.createdAt).toLocaleDateString() : "N/A"}</td>
                </tr>
            `,
        )
        .join("");
    } catch (err) {
      listEl.innerHTML = `<tr><td colspan="5" class="text-center text-danger">Error loading products.</td></tr>`;
    }
  }
  fetchProducts();
</script>

<%- include('partials/footer') %>
