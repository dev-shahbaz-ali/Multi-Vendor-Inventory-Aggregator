<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">📦 Product Catalog</h1>
  <a href="/add-product" class="btn btn-primary">+ Add New Product</a>
</div>

<div class="table-responsive bg-white rounded shadow-sm">
  <table class="table table-hover align-middle mb-0">
    <thead class="table-light">
      <tr>
        <th>Product Name</th>
        <th>SKU</th>
        <th>Current Price</th>
        <th>Description</th>
        <th>Date Added</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody id="productsList">
      <tr>
        <td colspan="6" class="text-center py-4">Loading products...</td>
      </tr>
    </tbody>
  </table>
</div>

<!-- Edit Price Modal -->
<div class="modal fade" id="priceModal" tabindex="-1">
  <div class="modal-dialog modal-sm">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Update Price</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted small mb-2" id="modal-product-name"></p>
        <label class="form-label fw-bold">New Price ($)</label>
        <input type="number" id="new-price" class="form-control" min="0" step="0.01" />
        <div id="price-error" class="text-danger small mt-1 d-none"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary btn-sm" onclick="savePrice()">Save</button>
      </div>
    </div>
  </div>
</div>

<script>
  let editingProductId = null;
  let priceModal = null;

  async function fetchProducts() {
    const listEl = document.getElementById("productsList");
    try {
      const response = await fetch("/api/products");
      const result = await response.json();
      const products = result.data || [];

      if (!products.length) {
        listEl.innerHTML =
          '<tr><td colspan="6" class="text-center py-4 text-muted">No products found.</td></tr>';
        return;
      }

      listEl.innerHTML = products
        .map(
          (p) => `
            <tr>
              <td class="fw-bold text-dark">${p.name || "N/A"}</td>
              <td><span class="badge bg-secondary font-monospace">${p.sku || "N/A"}</span></td>
              <td class="text-success fw-bold">$${(p.currentPrice || 0).toFixed(2)}</td>
              <td class="text-muted small">${p.description || "-"}</td>
              <td>${p.createdAt ? new Date(p.createdAt).toLocaleDateString() : "N/A"}</td>
              <td>
                <button class="btn btn-sm btn-outline-primary"
                  onclick="openPriceModal('${p._id}', '${p.name}', ${p.currentPrice})">
                  Edit Price
                </button>
              </td>
            </tr>
          `
        )
        .join("");
    } catch (err) {
      listEl.innerHTML = `<tr><td colspan="6" class="text-center text-danger">Error loading products.</td></tr>`;
    }
  }

  function openPriceModal(id, name, currentPrice) {
    editingProductId = id;
    document.getElementById("modal-product-name").textContent = name;
    document.getElementById("new-price").value = currentPrice.toFixed(2);
    document.getElementById("price-error").classList.add("d-none");
    priceModal = priceModal || new bootstrap.Modal(document.getElementById("priceModal"));
    priceModal.show();
  }

  async function savePrice() {
    const priceInput = document.getElementById("new-price").value;
    const errorEl = document.getElementById("price-error");
    errorEl.classList.add("d-none");

    if (!priceInput || isNaN(Number(priceInput)) || Number(priceInput) < 0) {
      errorEl.textContent = "Enter a valid non-negative price.";
      errorEl.classList.remove("d-none");
      return;
    }

    try {
      const res = await fetch(`/api/products/${editingProductId}/price`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ currentPrice: parseFloat(priceInput) }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Update failed");

      priceModal.hide();
      fetchProducts(); // refresh the table
    } catch (err) {
      errorEl.textContent = err.message;
      errorEl.classList.remove("d-none");
    }
  }

  fetchProducts();
</script>

<%- include('partials/footer') %>
