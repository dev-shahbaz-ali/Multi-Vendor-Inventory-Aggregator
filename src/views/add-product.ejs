<%- include('partials/header') %>

<div class="card shadow-sm mx-auto" style="max-width: 600px">
  <div class="card-header bg-primary text-white">
    <h2 class="h5 mb-0">✨ Add New Product</h2>
  </div>
  <div class="card-body">
    <form id="addProductForm">
      <div class="mb-3">
        <label class="form-label fw-bold">Product Name</label>
        <input type="text" id="name" class="form-control" required />
      </div>
      <div class="row mb-3">
        <div class="col">
          <label class="form-label fw-bold">SKU</label>
          <input type="text" id="sku" class="form-control" required />
        </div>
        <div class="col">
          <label class="form-label fw-bold">Price ($)</label>
          <input
            type="number"
            id="currentPrice"
            class="form-control"
            step="0.01"
            required
          />
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label fw-bold">Vendor ID</label>
        <input
          type="text"
          id="vendorId"
          class="form-control"
          placeholder="e.g. Amazon"
          required
        />
      </div>
      <div class="mb-3">
        <label class="form-label fw-bold">Description</label>
        <textarea id="description" class="form-control" rows="3"></textarea>
      </div>
      <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">
        Create Product
      </button>
    </form>
    <div id="message" class="mt-3 alert d-none"></div>
  </div>
</div>

<script>
  document
    .getElementById("addProductForm")
    .addEventListener("submit", async (e) => {
      e.preventDefault();
      const msgDiv = document.getElementById("message");
      msgDiv.classList.add("d-none");

      const payload = {
        name: document.getElementById("name").value,
        sku: document.getElementById("sku").value,
        vendorId: document.getElementById("vendorId").value,
        currentPrice: parseFloat(document.getElementById("currentPrice").value),
        description: document.getElementById("description").value,
      };

      try {
        const response = await fetch("/api/products", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (response.ok) {
          msgDiv.className = "mt-3 alert alert-success";
          msgDiv.textContent = "Product added successfully!";
          document.getElementById("addProductForm").reset();
        } else throw new Error("Failed to add product");
      } catch (err) {
        msgDiv.className = "mt-3 alert alert-danger";
        msgDiv.textContent = err.message;
      }
      msgDiv.classList.remove("d-none");
    });
</script>

<%- include('partials/footer') %>
